model User {
  id         String     @id @default(cuid())
  name       String
  email      String     @unique
  password   String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  categories Category[]
  routines   Routine[]
  tasks      Task[]

  sessions                    Session[]
  routineSuggestionDismissals RoutineSuggestionDismissal[]
}

model Session {
  id     String @id
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())
}
